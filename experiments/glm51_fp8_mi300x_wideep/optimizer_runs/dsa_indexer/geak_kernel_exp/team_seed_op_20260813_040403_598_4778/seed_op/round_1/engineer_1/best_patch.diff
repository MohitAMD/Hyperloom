+# The KV operand reaches the MFMA as fp8 (1 byte/element) on gfx942.
+_GFX942_KV_ELEM_BYTES = 1
+# Measured LDS the Triton stream pipeliner adds on top of the raw tile.
+_GFX942_PIPELINE_SLACK_BYTES = 512
 
 
